{
  "title": "SRE Lab — RED metrics & Circuit Breaker",
  "uid": "sre-lab-red",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "sre-lab"
  ],
  "panels": [
    {
      "id": 100,
      "title": "🔴 Circuit Breaker Story — recommendations",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 4,
      "title": "CB state (сейчас)",
      "description": "0 = closed (норма) · 1 = half-open (пробуем восстановиться) · 2 = open (зависимость отключена, работаем в degraded-режиме)",
      "type": "stat",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 7, "w": 4, "x": 0, "y": 1 },
      "targets": [
        { "expr": "backend_circuit_breaker_state", "legendFormat": "state" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED" } } },
            { "type": "value", "options": { "1": { "text": "HALF-OPEN" } } },
            { "type": "value", "options": { "2": { "text": "OPEN" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 101,
      "title": "CB state во времени (когда именно размыкалась цепь)",
      "description": "Полосы по времени: зелёная = CLOSED, жёлтая = HALF-OPEN, красная = OPEN. Сравните с графиком трафика recommendations ниже — под красными полосами трафик должен падать в ноль.",
      "type": "state-timeline",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 7, "w": 20, "x": 4, "y": 1 },
      "targets": [
        { "expr": "backend_circuit_breaker_state", "legendFormat": "CB state" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "HALF-OPEN", "color": "yellow" } } },
            { "type": "value", "options": { "2": { "text": "OPEN", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "always",
        "rowHeight": 0.9,
        "alignValue": "left"
      }
    },
    {
      "id": 5,
      "title": "Recommendations — Rate (сюда смотреть при OPEN)",
      "description": "Реальный трафик, дошедший до сервиса recommendations. Совместите глазами с полосами CB state выше: во время OPEN здесь должен быть провал в ноль.",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(recommendations_http_requests_total[1m])) by (status)", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Product card (/api/products/:id) — graceful degradation",
      "description": "В graceful backend отдаёт 200 и товар без рекомендаций, даже когда breaker OPEN и трафик к recommendations на панели выше упал в ноль. В strict-режиме здесь появится 429/5xx.",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 15 },
      "targets": [
        { "expr": "sum(rate(backend_http_requests_total{route=\"/api/products/:id\"}[1m])) by (status)", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },

    {
      "id": 110,
      "title": "📦 Recommendations service (RED)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "panels": []
    },
    {
      "id": 5001,
      "title": "Recommendations — Rate",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "targets": [
        { "expr": "sum(rate(recommendations_http_requests_total[1m])) by (status)", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Recommendations — Errors",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "targets": [
        { "expr": "sum(rate(recommendations_http_requests_total{status!=\"OK\"}[1m])) by (status)", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "Recommendations — Duration p95",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(recommendations_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 13,
      "title": "Recommendations — Rate limit (429 / сек)",
      "description": "429 — защитный ответ от перегрузки. Он не должен открывать circuit breaker: backend отличает rate limit от технической ошибки зависимости.",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "targets": [
        { "expr": "sum(rate(recommendations_rate_limit_rejections_total[1m]))", "legendFormat": "rejected" },
        { "expr": "recommendations_rate_limit_requests_per_second", "legendFormat": "configured RPS" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 24,
      "title": "Recommendations — получено запросов за 5м (bars, когда OPEN — баров нет)",
      "description": "Столбики = сколько запросов реально дошло до сервиса recommendations за последние 5 минут, по status. При CB OPEN backend вообще перестаёт ходить к сервису — новых столбиков нет.",
      "type": "barchart",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "targets": [
        { "expr": "sum(increase(recommendations_http_requests_total[5m])) by (status)", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },

    {
      "id": 120,
      "title": "🧾 Backend / Checkout (RED)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "panels": []
    },
    {
      "id": 1,
      "title": "Backend — Rate (запросов/сек по route)",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "targets": [
        { "expr": "sum(rate(backend_http_requests_total[1m])) by (route)", "legendFormat": "{{route}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Backend — Errors (доля не-200 ответов)",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "targets": [
        { "expr": "sum(rate(backend_http_requests_total{status!=\"OK\"}[1m])) by (route, status)", "legendFormat": "{{route}} — {{status}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Backend — Duration p95",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(backend_http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "p95 {{route}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 8,
      "title": "Checkout (POST /api/orders) — Rate & Errors",
      "description": "Обратите внимание: неудачная оплата (карта отклонена или payment деградировал) отвечает HTTP 402, а не 5xx — заказ создаётся в любом случае.",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "targets": [
        { "expr": "sum(rate(backend_http_requests_total{route=\"/api/orders\"}[1m])) by (status)", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 9,
      "title": "Checkout — Duration p95",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(backend_http_request_duration_seconds_bucket{route=\"/api/orders\"}[5m])) by (le))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },

    {
      "id": 130,
      "title": "💳 Payment service (RED) + Circuit Breaker",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 },
      "panels": []
    },
    {
      "id": 10,
      "title": "CB: backend → payment",
      "description": "0 = closed (норма) · 1 = half-open · 2 = open. Отдельный breaker от recommendations — падение оплаты не должно размыкать цепь рекомендаций и наоборот.",
      "type": "stat",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 57 },
      "targets": [
        { "expr": "backend_payment_circuit_breaker_state", "legendFormat": "state" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED" } } },
            { "type": "value", "options": { "1": { "text": "HALF-OPEN" } } },
            { "type": "value", "options": { "2": { "text": "OPEN" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Payment — Rate & Errors",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 57 },
      "targets": [
        { "expr": "sum(rate(payment_http_requests_total[1m])) by (status)", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 12,
      "title": "Payment — Duration p95 (сравните с bank.authorize / payments.persist в трейсах)",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 57 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(payment_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },

    {
      "id": 140,
      "title": "🛡 Resilience patterns",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 65 },
      "panels": []
    },
    {
      "id": 20,
      "title": "Retry — повторы",
      "description": "Повторные попытки запроса зависимостей при временных сбоях (5xx/сеть) с экспоненциальной задержкой. Рост retries и exhausted — признак flaky-зависимости, которую выхаживает retry вместо грубого 5xx.",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 66 },
      "targets": [
        { "expr": "sum by (dependency) (rate(backend_resilience_retries_total[1m]))", "legendFormat": "{{dependency}} retries" },
        { "expr": "sum by (dependency) (rate(backend_resilience_retry_exhausted_total[1m]))", "legendFormat": "{{dependency}} exhausted" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 21,
      "title": "Timeout — таймауты зависимостей",
      "description": "Сколько раз запрос к зависимости не уложился в настроенный таймаут и был прерван, чтобы не ждать бесконечно.",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 66 },
      "targets": [
        { "expr": "sum by (dependency) (rate(backend_resilience_timeout_exceeded_total[1m]))", "legendFormat": "{{dependency}} timeout" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 22,
      "title": "Bulkhead — отказы перегородки",
      "description": "Сколько запросов к зависимости отклонено перегородкой (fail fast), потому что все изолированные слоты заняты. Защита от каскадных сбоев.",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 66 },
      "targets": [
        { "expr": "sum by (dependency) (rate(backend_resilience_bulkhead_rejections_total[1m]))", "legendFormat": "{{dependency}} rejected" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 23,
      "title": "Fallback — кэш последнего успеха",
      "description": "Сколько раз вместо упавшей зависимости отдан кэш последнего успешного результата (деградация до запасного пути, а не ошибка).",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 66 },
      "targets": [
        { "expr": "sum by (dependency) (rate(backend_resilience_fallback_hits_total[1m]))", "legendFormat": "{{dependency}} hits" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },

    {
      "id": 150,
      "title": "👤 Пользователи и сессии",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 75 },
      "panels": []
    },
    {
      "id": 151,
      "title": "Входы (rate)",
      "description": "Бизнес-метрика входов в лабу (вход по имени без пароля).",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 76 },
      "targets": [
        { "expr": "sum(rate(backend_user_logins_total[1m]))", "legendFormat": "logins" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 152,
      "title": "Активные сессии",
      "description": "Gauge числа активных in-memory сессий backend.",
      "type": "stat",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 76 },
      "targets": [
        { "expr": "backend_active_sessions", "legendFormat": "sessions" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 153,
      "title": "Отказы доступа к админке (rate)",
      "description": "401 (нет сессии) / 403 (роль не admin) на /admin/* ручки.",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 76 },
      "targets": [
        { "expr": "sum(rate(backend_admin_denied_total[1m]))", "legendFormat": "admin denied" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },

    {
      "id": 160,
      "title": "📦 Склад",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 82 },
      "panels": []
    },
    {
      "id": 161,
      "title": "Резервирование / возврат / восполнение (rate)",
      "description": "Движения остатков по причине: reserve (списание в checkout), unreserve (возврат при неудачной оплате), restock (админка).",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 83 },
      "targets": [
        { "expr": "sum(rate(backend_stock_movement_total[1m])) by (reason)", "legendFormat": "{{reason}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 162,
      "title": "Заказы, заблокированные складом (rate)",
