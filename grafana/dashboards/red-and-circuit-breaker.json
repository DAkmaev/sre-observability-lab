      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 83 },
      "targets": [
        { "expr": "sum(rate(backend_orders_blocked_by_stock_total[1m]))", "legendFormat": "blocked" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 163,
      "title": "Товаров без остатка",
      "description": "Gauge числа товаров с нулевым остатком (обновляется при чтении /admin/stock).",
