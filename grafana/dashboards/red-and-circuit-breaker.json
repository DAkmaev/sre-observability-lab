{
  "title": "SRE Lab — RED metrics & Circuit Breaker",
  "uid": "sre-lab-red",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "sre-lab"
  ],
  "panels": [
    {
      "id": 100,
      "title": "🔴 Circuit Breaker Story — recommendations",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 4,
      "title": "CB state (сейчас)",
      "description": "0 = closed (норма) · 1 = half-open (пробуем восстановиться) · 2 = open (зависимость отключена, работаем в degraded-режиме)",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm-metrics"
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "backend_circuit_breaker_state",
          "legendFormat": "state"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CLOSED"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "HALF-OPEN"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "OPEN"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 101,
      "title": "CB state во времени",
      "description": "Полосы по времени: зелёная = CLOSED, жёлтая = HALF-OPEN, красная = OPEN. Сравните с графиком трафика recommendations ниже — под красными полосами трафик должен падать в ноль.",
      "type": "state-timeline",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm-metrics"
      },
      "gridPos": {
        "h": 3,
        "w": 20,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "backend_circuit_breaker_state",
          "legendFormat": "CB state"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CLOSED",
                  "color": "#1f3d2b",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "HALF-OPEN",
                  "color": "#e0b400",
                  "index": 1
                }
              }
            },
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "OPEN",
                  "color": "#e02f44",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.5,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "title": "Recommendations — Rate (красные полосы = CB OPEN)",
      "description": "Реальный трафик, дошедший до сервиса recommendations. Совместите глазами с полосами CB state выше: во время OPEN здесь должен быть провал в ноль.",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm-metrics"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum(rate(recommendations_http_requests_total[1m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        },
        {
          "expr": "backend_circuit_breaker_state == bool 2",
          "legendFormat": "CB OPEN",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CB OPEN"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "bars"
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.barAlignment",
                "value": 0
              },
              {
                "id": "custom.axisPlacement",
                "value": "hidden"
              },
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": true,
                  "tooltip": true,
                  "viz": false
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              }
            ]
          }
        ]
      }
    },
    {
      "id": 14,
      "title": "Product card (/api/products/:id) — graceful degradation",
      "description": "В graceful backend отдаёт 200 и товар без рекомендаций, даже когда breaker OPEN и трафик к recommendations на панели выше упал в ноль. В strict-режиме здесь появится 429/5xx.",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm-metrics"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "expr": "sum(rate(backend_http_requests_total{route=\"/api/products/:id\"}[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
