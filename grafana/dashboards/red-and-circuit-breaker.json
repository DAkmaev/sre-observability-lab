      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 83 },
      "targets": [
        { "expr": "backend_low_stock_products", "legendFormat": "low stock" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },

    {
      "id": 170,
      "title": "⭐ Отзывы",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 89 },
      "panels": []
    },
    {
      "id": 171,
      "title": "Опубликовано / отклонено (rate)",
      "description": "ReviewPosted — успех; ReviewRejected — рейтинг вне 1..5 или пустой комментарий.",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 90 },
      "targets": [
        { "expr": "sum(rate(backend_reviews_posted_total[1m]))", "legendFormat": "posted" },
        { "expr": "sum(rate(backend_reviews_rejected_total[1m]))", "legendFormat": "rejected" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 172,
      "title": "Отзывы по оценке (rate)",
      "description": "Гистограмма распределения оценок 1..5.",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "vm-metrics" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 90 },
      "targets": [
        { "expr": "sum(rate(backend_reviews_by_rating_total[1m])) by (rating)", "legendFormat": "{{rating}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    }
  ]
}
