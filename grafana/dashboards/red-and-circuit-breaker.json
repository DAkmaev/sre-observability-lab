    {
      "id": 13,
      "title": "Recommendations — Rate limit (429 / сек)",
      "description": "429 — защитный ответ от перегрузки. Он не должен открывать circuit breaker: backend отличает rate limit от технической ошибки зависимости.",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "expr": "sum(rate(recommendations_rate_limit_rejections_total[1m]))",
          "legendFormat": "rejected"
        },
        {
          "expr": "recommendations_rate_limit_requests_per_second",
          "legendFormat": "configured RPS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 24,
      "title": "Recommendations — получено запросов за 5м (bars, когда OPEN — баров нет)",
      "description": "Столбики = сколько запросов реально дошло до сервиса recommendations за последние 5 минут, по status. При CB OPEN backend вообще перестаёт ходить к сервису — новых столбиков нет.",
      "type": "barchart",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "vm-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "targets": [
        {
          "expr": "sum(increase(recommendations_http_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
